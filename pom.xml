        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version> <!-- или актуальная версия -->
            <scope>provided</scope> <!-- важно: сервер (Tomcat) уже предоставляет API -->
        </dependency>
        <dependency>
            <groupId>jakarta.servlet.jsp.jstl</groupId>
            <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
            <version>3.0.0</version> <!-- Стабильная версия (не RC) -->
        </dependency>
    </dependencies>
